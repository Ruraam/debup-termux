# Debup - GitHub DEB Package Manager
###################################

BOLD='\033[1m'
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
GRAY='\033[0;90m'
NC='\033[0m'

term_set_storage() {
if [ -d "/data/data/com.termux" ] || { [ -n "$PREFIX" ] && [[ "$PREFIX" == *com.termux* ]]; }; then
IS_TERMUX=true
[ -z "$PREFIX" ] && PREFIX="/data/data/com.termux/files/usr"
if [ ! -d "$HOME/storage" ] && command -v termux-setup-storage >/dev/null 2>&1; then
echo -e "${YELLOW}[!] Storage access is required for backups, please grant permission...${NC}"
termux-setup-storage
fi
else
IS_TERMUX=false
fi
}

check_termux_permissions() {
if [ "$IS_TERMUX" != true ]; then
return 0
fi

echo -e "${CYAN}[*] Checking Termux permissions...${NC}"

local issues=0

if [ ! -d "$HOME/storage" ]; then
echo -e "${YELLOW}[!] Storage access not granted.${NC}"
if command -v termux-setup-storage >/dev/null 2>&1; then
echo -e "${CYAN}[*] Requesting storage permission...${NC}"
termux-setup-storage
sleep 1
if [ -d "$HOME/storage" ]; then
echo -e "${GREEN}[✓] Storage permission granted.${NC}"
else
echo -e "${RED}[X] Storage permission denied.${NC}"
((issues++))
fi
else
echo -e "${RED}[X] termux-setup-storage not available.${NC}"
((issues++))
fi
else
echo -e "${GREEN}[✓] Storage access OK.${NC}"
fi

if [ ! -w "$PREFIX/bin" ]; then
echo -e "${RED}[X] No write permission in $PREFIX/bin${NC}"
((issues++))
else
echo -e "${GREEN}[✓] Write permission in $PREFIX/bin OK.${NC}"
fi

if [[ ":$PATH:" != *":$PREFIX/bin:"* ]]; then
echo -e "${YELLOW}[!] $PREFIX/bin is not in your PATH.${NC}"
echo -e "    Add this to your ~/.bashrc :"
echo -e "    ${GRAY}export PATH=\"\$PREFIX/bin:\$PATH\"${NC}"
((issues++))
else
echo -e "${GREEN}[✓] $PREFIX/bin is in PATH.${NC}"
fi

local missing_tools=()
for tool in curl jq dpkg-deb find; do
if ! command -v "$tool" >/dev/null 2>&1; then
missing_tools+=("$tool")
fi
done

if [ ${#missing_tools[@]} -gt 0 ]; then
echo -e "${YELLOW}[!] Missing tools: ${missing_tools[*]}${NC}"
echo -e "${CYAN}[*] Installing missing tools...${NC}"
if pkg install -y "${missing_tools[@]}"; then
echo -e "${GREEN}[✓] Required tools installed.${NC}"
else
echo -e "${RED}[X] Failed to install required tools.${NC}"
((issues++))
fi
else
echo -e "${GREEN}[✓] Required tools are installed.${NC}"
fi

if [ "$issues" -gt 0 ]; then
echo -e "${YELLOW}[!] Some permission/setup issues were detected.${NC}"
return 1
fi

echo -e "${GREEN}[✓] All Termux permissions and requirements OK.${NC}"
return 0
}

term_set_storage
if [ "$IS_TERMUX" = true ]; then
check_termux_permissions
fi

has_termux_api() {
command -v termux-notification >/dev/null 2>&1
}

termux_notify() {
local title="$1"
local content="$2"
has_termux_api || return 0
termux-notification \
--id "debup" \
--title "$title" \
--content "$content" \
--priority default \
2>/dev/null
}

termux_toast() {
command -v termux-toast >/dev/null 2>&1 || return 0
termux-toast -s "$1" 2>/dev/null
}

termux_vibrate() {
command -v termux-vibrate >/dev/null 2>&1 && termux-vibrate -d 180 2>/dev/null
}

install_termux_binary() {
local deb_file="$1"
local pkg_name="$2"
local version="$3"

local extract_dir
extract_dir=$(mktemp -d "$TEMP_DIR/extract.XXXXXX")

echo -e "${YELLOW}[*] Extracting .deb for Termux...${NC}"
if ! dpkg-deb -x "$deb_file" "$extract_dir"; then
echo -e "${RED}[X] Failed to extract .deb${NC}"
rm -rf "$extract_dir"
return 1
fi

if dpkg-deb -e "$deb_file" "$extract_dir/DEBIAN" 2>/dev/null; then
if [ -f "$extract_dir/DEBIAN/control" ]; then
local depends
depends=$(grep -i "^Depends:" "$extract_dir/DEBIAN/control" | cut -d: -f2- | tr ',' '\n' | sed 's/([^)]*)//g' | sed 's/^ *//g' | sed 's/ *$//g' | grep -v '^$')

if [ -n "$depends" ]; then
echo -e "${CYAN}[*] Dependencies found in .deb:${NC}"
echo "$depends" | sed 's/^/   - /'

echo -e "${YELLOW}[*] Trying to install available dependencies via pkg...${NC}"
local dep
while IFS= read -r dep; do
[ -z "$dep" ] && continue

case "$dep" in
libc6|libstdc++6|libgcc-s1|libglib2.0-0|zlib1g) continue ;;
esac

if pkg list-installed "$dep" &>/dev/null; then
echo -e "   ${GREEN}✓${NC} $dep (already installed)"
else
if pkg search "$dep" 2>/dev/null | grep -q "^$dep/"; then
echo -e "   ${YELLOW}→ Installing $dep...${NC}"
pkg install -y "$dep" &>/dev/null && \
echo -e "   ${GREEN}✓${NC} $dep installed" || \
echo -e "   ${RED}✗${NC} Failed to install $dep"
else
echo -e "   ${GRAY}• $dep (not available in Termux repos)${NC}"
fi
fi
done <<< "$depends"
fi
fi
fi

local binaries
binaries=$(find "$extract_dir" -type f -executable \
\( -path "*/bin/*" -o -path "*/usr/bin/*" -o -path "*/usr/local/bin/*" -o -path "*/sbin/*" \) 2>/dev/null)

if [ -z "$binaries" ]; then
echo -e "${RED}[X] No executable binary found inside the .deb${NC}"
rm -rf "$extract_dir"
return 1
fi

local count
count=$(echo "$binaries" | wc -l)

local target_bin=""
if [ "$count" -eq 1 ]; then
target_bin=$(echo "$binaries" | head -n1)
else
target_bin=$(echo "$binaries" | xargs -I{} sh -c 'echo $(stat -c%s "{}") {}' 2>/dev/null | sort -nr | head -n1 | cut -d' ' -f2-)
echo -e "${YELLOW}[!] Multiple binaries found. Installing the largest one:${NC} $(basename "$target_bin")"
fi

local bin_name
bin_name=$(basename "$target_bin")

mkdir -p "$PREFIX/bin"
cp "$target_bin" "$PREFIX/bin/$bin_name"
chmod +x "$PREFIX/bin/$bin_name"

mkdir -p "$CONF_DIR"
echo "$version" > "$CONF_DIR/${pkg_name}.version"

echo -e "${GREEN}[✓] Binary installed:${NC} $PREFIX/bin/$bin_name"

rm -rf "$extract_dir"
return 0
}

get_termux_version() {
local pkg_name="$1"
if [ -f "$CONF_DIR/${pkg_name}.version" ]; then
cat "$CONF_DIR/${pkg_name}.version"
else
echo ""
fi
}

CONF_DIR="${PREFIX:-/data/data/com.termux/files/usr}/etc/debup"
SOURCES_FILE="${CONF_DIR}/sources.list"

TEMP_DIR=$(mktemp -d "${PREFIX:-/data/data/com.termux/files/usr}/tmp/debup.XXXXXX")
cleanup() {
rm -rf "$TEMP_DIR"
}
trap cleanup EXIT INT TERM

ARCH=$(dpkg --print-architecture 2>/dev/null || echo "arm64")

ARCH_REGEX="$ARCH|all"
if [ "$ARCH" = "arm64" ]; then
ARCH_REGEX="arm64|aarch64|arm-64|armv8|arm64v8|all"
fi

filter_compatible_debs() {
local assets="$1"
local filtered
filtered=$(echo "$assets" | grep -iE "(${ARCH_REGEX})")
if [ "$ARCH" = "arm64" ]; then
filtered=$(echo "$filtered" | grep -ivE "armhf|armeabi" || true)
fi
echo "$filtered"
}

if [ ! -d "$CONF_DIR" ]; then
mkdir -p "$CONF_DIR" 2>/dev/null || mkdir -p "$CONF_DIR"
fi

if [ ! -f "$SOURCES_FILE" ]; then
touch "$SOURCES_FILE" 2>/dev/null
fi

if [ -z "$GITHUB_TOKEN" ] && [ -f "$CONF_DIR/debup.conf" ]; then
GITHUB_TOKEN=$(grep -E '^GITHUB_TOKEN=' "$CONF_DIR/debup.conf" | cut -d'=' -f2- | tr -d '"'\''')
fi

AUTH_HEADER=()
if [ -n "$GITHUB_TOKEN" ]; then
AUTH_HEADER=(-H "Authorization: Bearer $GITHUB_TOKEN")
fi

set_github_token() {
local token="$1"

if [ -z "$token" ]; then
echo -en "${CYAN}Enter your GitHub Personal Access Token (PAT):${NC} "
read -rs token </dev/tty
echo ""
fi

if [ -z "$token" ]; then
echo -e "${BLUE}---------------------------------------${NC}"
echo -e "${RED}[X] Error: Token cannot be empty.${NC}"
return 1
fi

mkdir -p "$CONF_DIR"
echo "GITHUB_TOKEN=\"$token\"" > "$CONF_DIR/debup.conf"

echo -e "${BLUE}---------------------------------------${NC}"
echo -e "${GREEN}[✓] GITHUB_TOKEN configured successfully!${NC}"
}

check_and_update() {
local REPO_URL="$1"
local PKG_NAME="$2"
local ASSUME_YES="$3"

local api_url
local repo_path=""

if [[ "$REPO_URL" == *"api.github.com"* ]]; then
api_url="${REPO_URL%/}/releases/latest"
else
repo_path=$(echo "$REPO_URL" | sed -E 's#^https?://github.com/##; s#/$##; s#\.git$##')
api_url="https://api.github.com/repos/${repo_path}/releases/latest"
fi

local release_json
release_json=$(curl -sSL \
"${AUTH_HEADER[@]}" \
-H "Accept: application/vnd.github+json" \
-H "User-Agent: debup" \
"$api_url")

local latest_tag
latest_tag=$(echo "$release_json" | jq -r '.tag_name // empty' 2>/dev/null | tr -d '\r')

if [ -z "$latest_tag" ]; then
local error_message
error_message=$(echo "$release_json" | jq -r '.message // empty' 2>/dev/null)

echo -e "${BLUE}---------------------------------------${NC}"
echo -e "${RED}[X] Error: Unable to fetch release info for${NC} ${CYAN}${repo_path:-$REPO_URL}${NC}"

if [ -n "$error_message" ]; then
echo -e "${BLUE}---------------------------------------${NC}"
echo -e "${RED}[X] GitHub API response:${NC} ${CYAN}${error_message}${NC}"
fi
return 1
fi

local remote_ver="${latest_tag#v}"

local local_ver=""
if [ -n "$PKG_NAME" ]; then
if [ "$IS_TERMUX" = true ]; then
local_ver=$(get_termux_version "$PKG_NAME")
else
local_ver=$(dpkg-query -W -f='${Version}' "$PKG_NAME" 2>/dev/null | tr -d '\r')
fi
fi
local_ver="${local_ver#v}"

echo -e "${YELLOW}==> Package:${NC}"
echo -e "${PKG_NAME:-New package} ${CYAN}${local_ver:-Not installed}${NC} ${GRAY}(${repo_path:-$REPO_URL})${NC}"
echo -e "${GREEN}Latest version:${NC}  ${remote_ver}"

if [ -n "$local_ver" ] && dpkg --compare-versions "$local_ver" ge "$remote_ver" 2>/dev/null; then
echo -e "${GREEN}[✓] Package is already up to date!${NC}"
echo -e "${BLUE}---------------------------------------${NC}"
return 0
fi

local candidate_urls
candidate_urls=$(echo "$release_json" | jq -r --arg arch "$ARCH_REGEX" \
'.assets[] | select((.name | endswith(".deb")) and (.name | test($arch; "i"))) | .browser_download_url')

if [ "$ARCH" = "arm64" ]; then
candidate_urls=$(echo "$candidate_urls" | grep -ivE "armhf|armeabi" || true)
fi

local deb_url=""
if [ -n "$candidate_urls" ]; then
deb_url=$(echo "$candidate_urls" | head -n1)
fi

if [ -z "$deb_url" ]; then
echo -e "${BLUE}---------------------------------------${NC}"
echo -e "${RED}[X] Error: No compatible .deb asset found for architecture ($ARCH).${NC}"
return 1
fi

if [ "$ASSUME_YES" != "true" ]; then
echo -e "${BLUE}---------------------------------------${NC}"
echo -e "${CYAN}[?] Do you want to download and install it? [y/N]:${NC}"
read -r confirm </dev/tty
if [[ ! "$confirm" =~ ^[yY]$ ]]; then
echo -e "${BLUE}---------------------------------------${NC}"
echo -e "${RED}[X] Operation canceled.${NC}"
return 0
fi
fi

local deb_filename
deb_filename=$(basename "$deb_url")
local tmp_deb="$TEMP_DIR/$deb_filename"

echo -e "${BLUE}---------------------------------------${NC}"
echo -e "${YELLOW}[*] Downloading:${NC} ${GRAY}${deb_url}${NC}"
if ! curl -L --progress-bar -o "$tmp_deb" "$deb_url"; then
echo -e "${BLUE}---------------------------------------${NC}"
echo -e "${RED}[X] Download failed.${NC}\n"
rm -f "$tmp_deb"
return 1
fi

if [ -z "$PKG_NAME" ]; then
PKG_NAME=$(dpkg-deb -f "$tmp_deb" Package 2>/dev/null || true)
fi

if [ "$IS_TERMUX" = true ]; then
if install_termux_binary "$tmp_deb" "$PKG_NAME" "$remote_ver"; then
rm -f "$tmp_deb"
echo -e "${BLUE}---------------------------------------${NC}"
echo -e "${GREEN}[✓] Successfully installed/updated ${PKG_NAME} (${latest_tag}) on Termux!${NC}\n"

termux_notify "debup" "✓ $PKG_NAME $remote_ver installed"
termux_toast "$PKG_NAME updated"
termux_vibrate

if [ -n "$PKG_NAME" ] && ! grep -q "^${PKG_NAME}|" "$SOURCES_FILE" 2>/dev/null; then
echo "${PKG_NAME}|${REPO_URL}" >> "$SOURCES_FILE"
fi
return 0
else
echo -e "${BLUE}---------------------------------------${NC}"
echo -e "${RED}[X] Termux binary installation failed.${NC}\n"
termux_toast "Failed: $PKG_NAME"
rm -f "$tmp_deb"
return 1
fi
else
echo -e "${YELLOW}[*] Installing package${NC} (sudo required)..."
if sudo apt install -y "$tmp_deb"; then
rm -f "$tmp_deb"
echo -e "${BLUE}---------------------------------------${NC}"
echo -e "${GREEN}[✓] Successfully installed/updated ${PKG_NAME} (${latest_tag})!${NC}\n"

if [ -n "$PKG_NAME" ] && ! grep -q "^${PKG_NAME}|" "$SOURCES_FILE" 2>/dev/null; then
echo "${PKG_NAME}|${REPO_URL}" | sudo tee -a "$SOURCES_FILE" >/dev/null
fi
return 0
else
echo -e "${BLUE}---------------------------------------${NC}"
echo -e "${RED}[X] Installation failed.${NC}\n"
rm -f "$tmp_deb"
return 1
fi
fi
}

debup_search() {
local query="$1"
if [ -z "$query" ]; then
echo -e "${BLUE}---------------------------------------${NC}"
echo -e "${RED}[!] Error:${NC} Usage: debup search <tool_name>"
return 1
fi

echo -e "${BLUE}---------------------------------------${NC}"
echo -e "${BLUE}::${NC}${CYAN}Searching for '$query' on GitHub...${NC}"

local raw_results
raw_results=$(curl -s "${AUTH_HEADER[@]}" "https://api.github.com/search/repositories?q=${query}+in:name&sort=stars&order=desc&per_page=10")

local raw_count
raw_count=$(echo "$raw_results" | jq -r '.items | length' 2>/dev/null)

if [ -z "$raw_count" ] || [ "$raw_count" -eq 0 ]; then
echo -e "${BLUE}---------------------------------------${NC}"
echo -e "${YELLOW}[!] No repositories found for '$query'.${NC}"
return 1
fi

echo -e "${GRAY}:: Verifying .deb releases for candidates...${NC}"

local repos=()
local stars_list=()
local desc_list=()
local valid_count=0

while IFS=$'\t' read -r repo stars desc; do
local check_release
check_release=$(curl -s "${AUTH_HEADER[@]}" "https://api.github.com/repos/${repo}/releases/latest")

local has_deb
has_deb=$(echo "$check_release" | jq -r '.assets[]?.name' 2>/dev/null | grep -i '\.deb$' | head -n1)

if [ -n "$has_deb" ]; then
repos+=("$repo")
stars_list+=("$stars")
desc_list+=("${desc:-No description provided}")
((valid_count++))

[ "$valid_count" -ge 5 ] && break
fi
done < <(echo "$raw_results" | jq -r '.items[] | [.full_name, (.stargazers_count|tostring), (.description // "")] | @tsv')

if [ "$valid_count" -eq 0 ]; then
echo -e "${BLUE}---------------------------------------${NC}"
echo -e "${YELLOW}[!] Found repositories for '$query', but none have .deb releases.${NC}"
return 1
fi

echo -e "\n${GREEN}Repositories found with .deb releases:${NC}"
echo -e "${BLUE}---------------------------------------------------------${NC}"

local i=1
for idx in "${!repos[@]}"; do
printf " ${YELLOW}[%d]${NC} ${BOLD}%-35s${NC} ${YELLOW}★ %-6s${NC}\n     ${GRAY}%s${NC}\n" \
"$i" "${repos[$idx]}" "${stars_list[$idx]}" "${desc_list[$idx]}"
((i++))
done

local choice
echo -e "${BLUE}---------------------------------------${NC}"
read -rp "Select a package to install [1-$valid_count] (Press Enter to cancel): " choice

if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "$valid_count" ]; then
local selected_repo="${repos[$((choice - 1))]}"
echo -e "\n${CYAN}:: Inspecting latest release assets for${NC} ${GREEN}$selected_repo${NC}..."

local release_data
release_data=$(curl -s "${AUTH_HEADER[@]}" "https://api.github.com/repos/${selected_repo}/releases/latest")

local deb_assets
deb_assets=$(echo "$release_data" | jq -r '.assets[]?.name' 2>/dev/null | grep -i '\.deb$')

if [ -z "$deb_assets" ]; then
echo -e "${BLUE}---------------------------------------${NC}"
echo -e "${RED}[X] Error: No .deb packages found in the latest release of this repository.${NC}"
echo -e "${YELLOW}Cannot install via debup.${NC}"
return 1
fi

local matching_deb
matching_deb=$(filter_compatible_debs "$deb_assets")

if [ -z "$matching_deb" ]; then
echo -e "${BLUE}---------------------------------------${NC}"
echo -e "${YELLOW}[!] Warning: .deb packages exist, but none seem to match your architecture ($ARCH).${NC}"
read -rp "Do you still want to proceed with the installation? [y/N]: " force_install
if [[ ! "$force_install" =~ ^[yY]$ ]]; then
echo -e "${BLUE}---------------------------------------${NC}"
echo -e "${CYAN}Installation cancelled.${NC}"
return 0
fi
fi

echo -e "${GREEN}[✓] Compatible package detected. Adding repository...${NC}"
check_and_update "$selected_repo" "" false
else
echo -e "${BLUE}---------------------------------------${NC}"
echo -e "${CYAN}Operation cancelled.${NC}"
fi
}

debup_info() {
local target="$1"
if [ -z "$target" ]; then
echo -e "${BLUE}---------------------------------------${NC}"
echo -e "${RED}[!] Error:${NC} Usage: debup info <owner/repo>"
return 1
fi

target=$(echo "$target" | sed -e 's|https://github.com/||g' -e 's|/$||')

echo -e "${BLUE}---------------------------------------${NC}"
echo -e "${BLUE}::${NC} ${CYAN}Fetching metadata for${NC} ${GREEN}$target${NC}..."

local repo_data
repo_data=$(curl -s "${AUTH_HEADER[@]}" "https://api.github.com/repos/${target}")

local not_found
not_found=$(echo "$repo_data" | jq -r '.message' 2>/dev/null)
if [ "$not_found" = "Not Found" ]; then
echo -e "${RED}[X] Error: Repository '$target' not found on GitHub.${NC}"
return 1
fi

local release_data
release_data=$(curl -s "${AUTH_HEADER[@]}" "https://api.github.com/repos/${target}/releases/latest")

local tag_name
tag_name=$(echo "$release_data" | jq -r '.tag_name // empty' 2>/dev/null)
if [ -z "$tag_name" ]; then
echo -e "${YELLOW}[!] Repository exists, but has no releases published.${NC}"
return 1
fi

local description stars license published_at deb_assets
description=$(echo "$repo_data" | jq -r '.description // "No description provided."')
stars=$(echo "$repo_data" | jq -r '.stargazers_count')
license=$(echo "$repo_data" | jq -r '.license.spdx_id // "None"')
published_at=$(echo "$release_data" | jq -r '.published_at' | cut -d'T' -f1)
deb_assets=$(echo "$release_data" | jq -r '.assets[]?.name' 2>/dev/null | grep -i '\.deb$')

local matching_deb
matching_deb=$(filter_compatible_debs "$deb_assets")

echo -e "${BLUE}---------------------------------------${NC}"
echo -e " ${BOLD}Package:${NC}      $target"
echo -e " ${BOLD}Latest:${NC}       ${GREEN}$tag_name${NC} ($published_at)"
echo -e " ${BOLD}Stars:${NC}        ${YELLOW}★ $stars${NC}"
echo -e " ${BOLD}License:${NC}      $license"
echo -e " ${BOLD}Description:${NC}  $description"
echo -e "${BLUE}---------------------------------------${NC}"

if [ -n "$matching_deb" ]; then
echo -e " ${BOLD}Compatible .deb ($ARCH):${NC}"
echo "$matching_deb" | sed 's/^/   • /'
elif [ -n "$deb_assets" ]; then
echo -e "${BLUE}---------------------------------------${NC}"
echo -e "${YELLOW}[!] .deb found, but NONE match your architecture ($ARCH):${NC}"
echo "$deb_assets" | sed 's/^/   • /'
else
echo -e "${BLUE}---------------------------------------${NC}"
echo -e " ${RED}[X] No .deb packages found in this release.${NC}"
fi
}

case "$1" in
add|install)
shift
ASSUME_YES="false"
REPO=""
while [ "$#" -gt 0 ]; do
case "$1" in
-y|--yes) ASSUME_YES="true" ;;
*) REPO="$1" ;;
esac
shift
done
echo -e "${BLUE}---------------------------------------${NC}"
[ -z "$REPO" ] && { echo -e "${YELLOW}Usage:${NC} ${GREEN}dbp${NC} add|install [-y] <owner/repo | github_url>"; exit 1; }
check_and_update "$REPO" "" "$ASSUME_YES"
;;

update|upgrade)
shift
ASSUME_YES="false"
while [ "$#" -gt 0 ]; do
case "$1" in
-y|--yes) ASSUME_YES="true" ;;
esac
shift
done

if [ ! -f "$SOURCES_FILE" ] || [ ! -s "$SOURCES_FILE" ]; then
echo -e "${BLUE}---------------------------------------${NC}"
echo -e "${YELLOW}[!] No packages managed by debup yet.${NC}"
exit 0
fi

updated_count=0
while IFS='|' read -r pkg repo || [ -n "$pkg" ]; do
[[ "$pkg" =~ ^#.* ]] && continue
[ -z "$pkg" ] && continue
if check_and_update "$repo" "$pkg" "$ASSUME_YES"; then
((updated_count++))
fi
echo ""
done < "$SOURCES_FILE"

if [ "$IS_TERMUX" = true ]; then
if [ "$updated_count" -gt 0 ]; then
termux_notify "debup" "$updated_count package(s) updated"
termux_toast "Upgrade finished ($updated_count)"
else
termux_toast "Everything up to date"
fi
termux_vibrate
fi
;;

list)
if [ ! -f "$SOURCES_FILE" ] || [ ! -s "$SOURCES_FILE" ]; then
echo -e "${BLUE}---------------------------------------${NC}"
echo -e "${YELLOW}[!] No packages registered.${NC}"
exit 0
fi
printf "%-25s %s\n" "PACKAGE" "REPOSITORY"
printf "%-25s %s\n" "-------" "----------"
while IFS='|' read -r pkg repo || [ -n "$pkg" ]; do
[[ "$pkg" =~ ^#.* ]] && continue
[ -z "$pkg" ] && continue
printf "%-25s %s\n" "$pkg" "$repo"
done < "$SOURCES_FILE"
;;

remove)
PKG="$2"
echo -e "${BLUE}---------------------------------------${NC}"
[ -z "$PKG" ] && { echo -e "${YELLOW}[!] Usage: debup remove <package_name>"; exit 1; }
if [ -f "$SOURCES_FILE" ]; then
sed -i "/^${PKG}|/d" "$SOURCES_FILE"
echo -e "${GREEN}[✓] ${PKG} removed from debup tracking.${NC}"
fi
read -rp "Do you also want to purge the package from the system using pkg? [y/N]: " del_sys
if [[ "$del_sys" =~ ^[yY]$ ]]; then
pkg remove -y "$PKG" 2>/dev/null || true
rm -f "$PREFIX/bin/$PKG" 2>/dev/null
rm -f "$CONF_DIR/${PKG}.version" 2>/dev/null
fi
;;

token|auth|ghtoken)
shift
set_github_token "$1"
;;

search)
shift
debup_search "$1"
;;

info|show)
debup_info "$2"
;;

help|--help|-h|"")
echo -e "${BLUE}------------------------------------------------------${NC}"
